# ─── Chariow (HUPPLE STORE) ──────────────────────────────────────────────────
# app.chariow.com → Settings → API Keys → Create API Key
# La clé complète n'est affichée qu'une seule fois : copie-la immédiatement.
CHARIOW_API_KEY=

# ─── Meta Marketing API ──────────────────────────────────────────────────────
# Jeton System User avec la permission ads_read, créé dans
# business.facebook.com → Paramètres d'entreprise → Utilisateurs système.
# Un jeton utilisateur classique expire en 60 jours ; le jeton System User, non.
META_ACCESS_TOKEN=

# Identifiant du compte publicitaire, avec ou sans le préfixe act_
META_AD_ACCOUNT_ID=act_000000000000000

# Facultatif — version de l'API Graph (par défaut v23.0)
META_API_VERSION=v23.0

# ─── Accès au tableau de bord ────────────────────────────────────────────────
# Identifiants uniques protégeant l'ensemble du site. Ce sont tes chiffres
# d'affaires : ne déploie jamais sans les renseigner.
# Changer le mot de passe déconnecte immédiatement toutes les sessions ouvertes.
DASHBOARD_EMAIL=
DASHBOARD_PASSWORD=

# ─── Taux de reversement Chariow (facultatif) ────────────────────────────────
# Part du montant de vente réellement reversée, après frais de paiement (8 %) et
# frais de service (7 %). Par défaut 0.85, barème constaté sur le plan Starter.
# L'API REST ne renvoyant pas le montant reversé, ce taux sert à le calculer.
# Vérifie-le sur un relevé réel si tu changes de plan.
# CHARIOW_NET_RATE=0.85

# ─── Conversion de devises (facultatif) ──────────────────────────────────────
# XOF et EUR sont liés par une parité fixe (655,957) : aucun taux à fournir.
# Si ton compte publicitaire est dans une autre devise, donne le taux vers XOF.
# Exemple pour un compte en dollars :
# RATE_USD_XOF=610
#
# Renseigne aussi la date de valeur du taux, au format AAAA-MM-JJ. Elle est
# affichée sous le resultat, et l'application signale un taux de plus de
# soixante jours. Un taux sans date derive silencieusement.
# RATE_USD_XOF_DATE=2026-08-07
